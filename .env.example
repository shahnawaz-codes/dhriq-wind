# Elexon API Configuration
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3
ELEXON_CHUNK_DAYS=7

# Evaluation Window & Cutoff Configuration
DELIVERY_WINDOW_START=2026-01-01
DELIVERY_WINDOW_END=2026-01-31
DECISION_CUTOFF_LOCAL_TIME=09:00
DECISION_TIMEZONE=Europe/London
FORECAST_PUBLISH_LOOKBACK_DAYS=2

# Cache & Startup
CACHE_TTL_SECONDS=86400
PRELOAD_ON_STARTUP=true

# Security & CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
PORT=8000

